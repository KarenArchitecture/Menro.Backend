// appsettings.Production.json
{
  "AppSettings": {
    "BaseUrl": "https://menro.ir"
  },

  "JwtSettings": {
    "Issuer": "MenroAuthServer",
    "Audience": "MenroApiUser",
    "ExpiryMinutes": 15
  },

  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "SeedSettings": {
    "EnableDemoSeed": true
  },

  "SmsSettings": {
    "BaseUrl": "https://api.sms.ir/",
    "OtpTemplateId": 690694
  }
}
